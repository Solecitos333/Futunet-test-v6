rules_version = '2';

// ═══════════════════════════════════════════════════
// FUTUNET - Firestore Security Rules
// ═══════════════════════════════════════════════════
//
// INSTRUCCIONES: Copia todo este contenido y pégalo en:
// Firebase Console → Firestore Database → Rules
//
// Seguridad implementada:
// ✅ Los usuarios solo pueden leer/escribir sus propios datos
// ✅ Solo admins/superadmins pueden gestionar usuarios y productos
// ✅ Roles verificados server-side (no se pueden auto-escalar)
// ✅ Validación de datos en escritura
// ✅ Inmune a SQL injection (Firestore es NoSQL con consultas tipadas)
// ═══════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userHasAnyRole(allowedRoles) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.role in allowedRoles ||
             (userData.roles is list && userData.roles.hasAny(allowedRoles));
    }

    function documentHasRole(userData, roleName) {
      return userData.role == roleName ||
             (userData.roles is list && roleName in userData.roles);
    }

    function isSuperAdmin() {
      return isEmailVerified() && userHasAnyRole(['superadmin']);
    }

    function isAdminOrAbove() {
      return isEmailVerified() && userHasAnyRole(['superadmin', 'admin']);
    }

    function isEditorOrAbove() {
      return isEmailVerified() && userHasAnyRole(['superadmin', 'admin', 'editor']);
    }

    function isPlatformStaff(allowedRoles) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isEmailVerified() &&
             (!('companyCode' in userData) || userData.companyCode == null || userData.companyCode == '') &&
             (userData.role in allowedRoles ||
              (userData.roles is list && userData.roles.hasAny(allowedRoles)));
    }

    function isPlatformSupport() {
      return isPlatformStaff(['superadmin', 'admin', 'support_agent']);
    }

    function isPlatformBilling() {
      return isPlatformStaff(['superadmin', 'admin', 'billing_clerk']);
    }

    function isPlatformMarketing() {
      return isPlatformStaff(['superadmin', 'admin', 'marketing_manager']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isScopedInternetClientUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
               'isInternetClient', 'clientCode', 'internetPlan', 'internetStatus',
               'latitude', 'longitude', 'locationNotes', 'locationAccuracy'
             ]) &&
             data.isInternetClient == true &&
             (!('clientCode' in data) || (data.clientCode is string && data.clientCode.size() <= 50)) &&
             (!('internetPlan' in data) || (data.internetPlan is string && data.internetPlan.size() <= 50)) &&
             data.internetStatus in ['active', 'suspended', 'inactive'] &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('locationNotes' in data) || (data.locationNotes is string && data.locationNotes.size() <= 500)) &&
             (!('locationAccuracy' in data) || (data.locationAccuracy is string && data.locationAccuracy.size() <= 100));
    }

    function isValidInternetPaymentReview() {
      let data = request.resource.data;
      return resource.data.status == 'pending' && (
        (data.status == 'approved' &&
         data.approvedAt == request.time &&
         data.approvedBy == request.auth.uid &&
         data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy'])) ||
        (data.status == 'rejected' &&
         data.rejectedAt == request.time &&
         data.rejectedBy == request.auth.uid &&
         data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedAt', 'rejectedBy']))
      );
    }

    function isValidServiceRequestCompletion() {
      let data = request.resource.data;
      return resource.data.status == 'pending' &&
             data.status == 'completed' &&
             data.completedAt == request.time &&
             data.completedBy == request.auth.uid &&
             data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy']);
    }

    function canAdminTenant(companyCodes, tenantAdminRole) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isEmailVerified() && (
        documentHasRole(userData, 'superadmin') ||
        (userData.companyCode in companyCodes && (
          documentHasRole(userData, 'admin') ||
          documentHasRole(userData, 'erp_admin') ||
          documentHasRole(userData, tenantAdminRole)
        ))
      );
    }

    function canOperateTenant(companyCodes, tenantAdminRole, tenantOperatorRole, tenantUserRole, tenantUsuarioRole) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isEmailVerified() && (
        documentHasRole(userData, 'superadmin') ||
        (userData.companyCode in companyCodes && (
          documentHasRole(userData, 'admin') ||
          documentHasRole(userData, 'erp_admin') ||
          documentHasRole(userData, 'editor') ||
          documentHasRole(userData, 'erp_operator') ||
          documentHasRole(userData, tenantAdminRole) ||
          documentHasRole(userData, tenantOperatorRole) ||
          documentHasRole(userData, tenantUserRole) ||
          documentHasRole(userData, tenantUsuarioRole)
        ))
      );
    }

    function isCreaticosAdmin() {
      return canAdminTenant(['CREATICOS'], 'creaticos_admin');
    }

    function isCreaticosOperator() {
      return canOperateTenant(['CREATICOS'], 'creaticos_admin', 'creaticos_operator', 'creaticos_user', 'creaticos_usuario');
    }

    function isFutunetAdmin() {
      return canAdminTenant(['FUTUNETSRL', 'FUTUNET'], 'futunetsrl_admin');
    }

    function isFutunetOperator() {
      return canOperateTenant(['FUTUNETSRL', 'FUTUNET'], 'futunetsrl_admin', 'futunetsrl_operator', 'futunetsrl_user', 'futunetsrl_usuario');
    }

    function isPanitasAdmin() {
      return canAdminTenant(['PANITAS'], 'panitas_admin');
    }

    function isPanitasOperator() {
      return canOperateTenant(['PANITAS'], 'panitas_admin', 'panitas_operator', 'panitas_user', 'panitas_usuario');
    }

    function isPanitasKitchen() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isEmailVerified() &&
             userData.companyCode == 'PANITAS' &&
             documentHasRole(userData, 'panitas_kitchen');
    }

    function isAnyTenantAdmin() {
      return isCreaticosAdmin() || isFutunetAdmin() || isPanitasAdmin();
    }

    function isCashSessionOwner() {
      return isSignedIn() && (
        ('openedByUid' in resource.data && resource.data.openedByUid == request.auth.uid) ||
        (!('openedByUid' in resource.data) && resource.data.openedBy == request.auth.token.email)
      );
    }

    function isValidCashSessionCreate() {
      let data = request.resource.data;
      return data.openedByUid == request.auth.uid &&
             data.openedBy == request.auth.token.email &&
             data.openedAt == request.time &&
             data.status == 'open' &&
             data.initialCash is number && data.initialCash >= 0 &&
             data.salesCash == 0 && data.salesCard == 0 && data.salesNfc == 0 &&
             data.salesTransfer == 0 && data.salesCredit == 0 &&
             data.transactionsCount == 0;
    }

    function isValidCashSessionUpdate() {
      return resource.data.status == 'open' &&
             request.resource.data.openedBy == resource.data.openedBy &&
             request.resource.data.openedAt == resource.data.openedAt &&
             request.resource.data.initialCash == resource.data.initialCash &&
             request.resource.data.openedByUid == request.auth.uid &&
             request.resource.data.status in ['open', 'closed'] &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'openedByUid', 'salesCash', 'salesCard', 'salesNfc', 'salesTransfer',
               'salesCredit', 'transactionsCount', 'closedAt', 'closedBy',
               'expectedCash', 'realCash', 'difference', 'notes', 'status'
             ]);
    }

    function isValidBillingInvoice() {
      let data = request.resource.data;
      return data.docType in ['invoice', 'quote', 'proforma', 'credit_note', 'debit_note'] &&
             data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 50 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 150 &&
             data.clientRnc is string && data.clientRnc.size() <= 30 &&
             data.date is string && data.date.size() == 10 &&
             data.dueDate is string && data.dueDate.size() == 10 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 200 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.itbis is number && data.itbis >= 0 &&
             data.total is number && data.total > 0 &&
             data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.total + 0.01 &&
             data.status in ['pending', 'partial', 'unpaid', 'paid', 'cancelled', 'quote', 'proforma', 'converted', 'issued', 'credited'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.ncf is string && data.ncf.size() <= 19 &&
             (
               !('fiscalSchemaVersion' in data) || data.fiscalSchemaVersion < 2 || (
                 data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.subtotal &&
                 data.taxableAmount is number && data.taxableAmount >= 0 &&
                 data.taxableAmount >= data.subtotal - data.discountAmount - 0.02 &&
                 data.taxableAmount <= data.subtotal - data.discountAmount + 0.02 &&
                 data.total >= data.taxableAmount + data.itbis - 0.02 &&
                 data.total <= data.taxableAmount + data.itbis + 0.02 &&
                 data.issuerSnapshot is map &&
                 data.customerSnapshot is map
               )
             );
    }

    function hasValidBillingCreateAudit() {
      let data = request.resource.data;
      return data.createdBy == request.auth.uid &&
             data.updatedBy == request.auth.uid &&
             data.createdAt == request.time && data.updatedAt == request.time &&
             data.companyCode in ['CREATICOS', 'FUTUNETSRL', 'PANITAS'] &&
             (
               (data.docType == 'invoice' && data.status in ['pending', 'partial', 'unpaid', 'paid'] &&
                 data.inventoryEffects is list && data.inventoryPostedAt == request.time) ||
               (data.docType == 'quote' && data.status == 'quote') ||
                (data.docType == 'proforma' && data.status == 'proforma') ||
                (data.docType in ['credit_note', 'debit_note'] && data.status == 'issued' &&
                  data.originalInvoiceId is string && data.originalInvoiceId.size() > 0 &&
                  data.modifiedNcf is string && data.modifiedNcf.matches('^B[0-9]{10}$') &&
                  data.inventoryEffects is list)
              );
    }

    function hasValidBillingUpdateAudit() {
      return request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time;
    }

    function isPaymentOnlyInvoiceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'paidAmount', 'status', 'lastPaymentId', 'updatedBy', 'updatedAt'
             ]) &&
             request.resource.data.paidAmount > resource.data.paidAmount &&
             request.resource.data.status in ['partial', 'paid'];
    }

    function isCancellationOnlyInvoiceUpdate() {
      return resource.data.docType == 'invoice' && resource.data.status != 'cancelled' &&
             resource.data.paidAmount == 0 && request.resource.data.status == 'cancelled' &&
             request.resource.data.cancelledBy == request.auth.uid &&
             request.resource.data.cancelledAt == request.time &&
             request.resource.data.cancellationDate is string && request.resource.data.cancellationDate.size() == 10 &&
             request.resource.data.cancellationType is string &&
             request.resource.data.cancellationType.matches('^(0[1-9]|10)$') &&
             request.resource.data.inventoryReversedAt == request.time &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelledAt', 'cancellationDate', 'cancellationType', 'cancelledBy',
               'inventoryReversedAt', 'updatedBy', 'updatedAt'
             ]);
    }

    function isFiscalAdjustmentOnlyInvoiceUpdate() {
      let data = request.resource.data;
      return resource.data.docType == 'invoice' &&
             data.creditedAmount is number && data.creditedAmount >= 0 &&
             data.debitedAmount is number && data.debitedAmount >= 0 &&
             data.refundedAmount is number && data.refundedAmount >= 0 &&
             data.lastAdjustmentId is string && data.lastAdjustmentId.size() > 0 &&
             data.status in ['pending', 'partial', 'unpaid', 'paid', 'credited'] &&
             data.diff(resource.data).affectedKeys().hasOnly([
               'creditedAmount', 'debitedAmount', 'refundedAmount', 'lastAdjustmentId',
               'status', 'creditRestockedAt', 'updatedBy', 'updatedAt'
             ]);
    }

    function matchesFiscalAdjustment(adjustment, invoiceId) {
      return adjustment.originalInvoiceId == invoiceId && (
        (adjustment.docType == 'credit_note' &&
          request.resource.data.creditedAmount - (('creditedAmount' in resource.data) ? resource.data.creditedAmount : 0) >= adjustment.total - 0.01 &&
          request.resource.data.creditedAmount - (('creditedAmount' in resource.data) ? resource.data.creditedAmount : 0) <= adjustment.total + 0.01 &&
          request.resource.data.debitedAmount == (('debitedAmount' in resource.data) ? resource.data.debitedAmount : 0) &&
          request.resource.data.refundedAmount - (('refundedAmount' in resource.data) ? resource.data.refundedAmount : 0) >= adjustment.refundAmount - 0.01 &&
          request.resource.data.refundedAmount - (('refundedAmount' in resource.data) ? resource.data.refundedAmount : 0) <= adjustment.refundAmount + 0.01) ||
        (adjustment.docType == 'debit_note' &&
          request.resource.data.debitedAmount - (('debitedAmount' in resource.data) ? resource.data.debitedAmount : 0) >= adjustment.total - 0.01 &&
          request.resource.data.debitedAmount - (('debitedAmount' in resource.data) ? resource.data.debitedAmount : 0) <= adjustment.total + 0.01 &&
          request.resource.data.creditedAmount == (('creditedAmount' in resource.data) ? resource.data.creditedAmount : 0) &&
          request.resource.data.refundedAmount == (('refundedAmount' in resource.data) ? resource.data.refundedAmount : 0))
      );
    }

    function hasValidNewBillingNcf() {
      let ncf = request.resource.data.ncf;
      return ncf == '' || ncf.matches('^B[0-9]{10}$');
    }

    function isValidNcfRegistryCreate(companyCode) {
      let data = request.resource.data;
      return data.keys().hasAll(['ncf', 'invoiceId', 'companyCode', 'createdBy', 'timestamp']) &&
             data.keys().hasOnly(['ncf', 'invoiceId', 'companyCode', 'createdBy', 'timestamp']) &&
             data.ncf is string && data.ncf.matches('^B[0-9]{10}$') &&
             data.invoiceId is string && data.invoiceId.size() > 0 && data.invoiceId.size() <= 150 &&
             data.companyCode == companyCode &&
             data.createdBy == request.auth.uid &&
             data.timestamp == request.time;
    }

    function isValidRefundCreate(companyCode) {
      let data = request.resource.data;
      return data.keys().hasAll([
               'invoiceId', 'adjustmentId', 'amount', 'method', 'reason',
               'companyCode', 'createdBy', 'timestamp'
             ]) &&
             data.keys().hasOnly([
               'invoiceId', 'adjustmentId', 'amount', 'method', 'reason',
               'companyCode', 'createdBy', 'timestamp'
             ]) &&
             data.invoiceId is string && data.invoiceId.size() > 0 &&
             data.adjustmentId is string && data.adjustmentId.size() > 0 &&
             data.amount is number && data.amount > 0 &&
             data.method in ['Efectivo', 'Tarjeta', 'Transferencia', 'Cheque'] &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 500 &&
             data.companyCode == companyCode &&
             data.createdBy == request.auth.uid &&
             data.timestamp == request.time;
    }

    function preservesBillingIdentity() {
      return request.resource.data.invoiceNumber == resource.data.invoiceNumber &&
             request.resource.data.docType == resource.data.docType &&
             request.resource.data.ncf == resource.data.ncf &&
             request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidBillingPayment() {
      let data = request.resource.data;
      return data.invoiceId is string && data.invoiceId.size() > 0 && data.invoiceId.size() <= 150 &&
             data.amount is number && data.amount > 0 &&
             data.method is string && data.method in ['Efectivo', 'Tarjeta', 'Transferencia', 'Cheque'] &&
             data.createdBy == request.auth.uid &&
             data.companyCode in ['CREATICOS', 'FUTUNETSRL', 'PANITAS'] &&
             data.cashSessionId is string && data.cashSessionId.size() <= 150 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.timestamp == request.time;
    }

    function isValidInventoryMovement() {
      let data = request.resource.data;
      return data.type in ['sale', 'sale_reversal', 'credit_note_return'] &&
             data.invoiceId is string && data.invoiceId.size() > 0 && data.invoiceId.size() <= 150 &&
             data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 50 &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() <= 250 &&
             data.productDocumentId is string && data.productDocumentId.size() > 0 && data.productDocumentId.size() <= 150 &&
             data.productCollection in ['products', 'creaticos_products', 'panitas_products'] &&
             data.quantity is number && data.quantity != 0 &&
             data.createdBy == request.auth.uid && data.timestamp == request.time;
    }

    function inventoryMovementMatchesStockUpdate(movement, productId, productCollection) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'stock', 'updatedAt', 'lastInventoryMovementId'
             ]) &&
             request.resource.data.stock is number &&
             request.resource.data.stock >= 0 &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.lastInventoryMovementId is string &&
             movement.productDocumentId == productId &&
             movement.productCollection == productCollection &&
             movement.quantity == request.resource.data.stock - resource.data.stock &&
             movement.createdBy == request.auth.uid &&
             movement.timestamp == request.time;
    }

    function inventoryMovementMatchesInvoice(invoice) {
      let movement = request.resource.data;
      return invoice.invoiceNumber == movement.invoiceNumber && (
        (movement.type == 'sale' &&
         invoice.docType == 'invoice' &&
         invoice.inventoryPostedAt == request.time) ||
        (movement.type == 'sale_reversal' &&
         invoice.docType == 'invoice' &&
         invoice.status == 'cancelled' &&
         invoice.inventoryReversedAt == request.time) ||
        (movement.type == 'credit_note_return' &&
         invoice.docType == 'credit_note' &&
         invoice.inventoryPostedAt == request.time)
      );
    }

    function hasCreaticosInventoryMovement(productId, productCollection) {
      return existsAfter(/databases/$(database)/documents/creaticos_inventory_movements/$(request.resource.data.lastInventoryMovementId)) &&
             inventoryMovementMatchesStockUpdate(
               getAfter(/databases/$(database)/documents/creaticos_inventory_movements/$(request.resource.data.lastInventoryMovementId)).data,
               productId,
               productCollection
             );
    }

    function hasFutunetInventoryMovement(productId, productCollection) {
      return existsAfter(/databases/$(database)/documents/futunet_inventory_movements/$(request.resource.data.lastInventoryMovementId)) &&
             inventoryMovementMatchesStockUpdate(
               getAfter(/databases/$(database)/documents/futunet_inventory_movements/$(request.resource.data.lastInventoryMovementId)).data,
               productId,
               productCollection
             );
    }

    function hasPanitasInventoryMovement(productId, productCollection) {
      return existsAfter(/databases/$(database)/documents/panitas_inventory_movements/$(request.resource.data.lastInventoryMovementId)) &&
             inventoryMovementMatchesStockUpdate(
               getAfter(/databases/$(database)/documents/panitas_inventory_movements/$(request.resource.data.lastInventoryMovementId)).data,
               productId,
               productCollection
             );
    }

    function isValidPurchaseCreate() {
      let data = request.resource.data;
      return data.supplierRnc is string && data.supplierRnc.matches('^([0-9]{9}|[0-9]{11})$') &&
             data.supplierName is string && data.supplierName.size() > 0 && data.supplierName.size() <= 150 &&
             data.ncf is string && (data.ncf.matches('^B[0-9]{10}$') || data.ncf.matches('^E[0-9]{12}$')) &&
             data.date is string && data.date.size() == 10 && data.dueDate is string && data.dueDate.size() == 10 &&
             data.paymentDate is string && (data.paymentDate == '' || data.paymentDate.size() == 10) &&
             data.retentionDate is string && (data.retentionDate == '' || data.retentionDate.size() == 10) &&
             data.expenseType.matches('^(0[1-9]|1[01])$') &&
             data.goodsAmount is number && data.goodsAmount >= 0 &&
             data.servicesAmount is number && data.servicesAmount >= 0 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.subtotal >= data.goodsAmount + data.servicesAmount - 0.01 &&
             data.subtotal <= data.goodsAmount + data.servicesAmount + 0.01 &&
             data.itbis is number && data.itbis >= 0 &&
             data.itbisWithheld is number && data.itbisWithheld >= 0 &&
             data.itbisProportional is number && data.itbisProportional >= 0 &&
             data.itbisCost is number && data.itbisCost >= 0 && data.itbisCost <= data.itbis &&
             data.itbisAdvance is number && data.itbisAdvance >= 0 &&
             data.itbisAdvance >= data.itbis - data.itbisCost - 0.01 &&
             data.itbisAdvance <= data.itbis - data.itbisCost + 0.01 &&
             data.itbisPerceived is number && data.itbisPerceived >= 0 &&
             data.incomeTaxWithheld is number && data.incomeTaxWithheld >= 0 &&
             data.incomeTaxPerceived is number && data.incomeTaxPerceived >= 0 &&
             data.selectiveTax is number && data.selectiveTax >= 0 &&
             data.otherTaxes is number && data.otherTaxes >= 0 &&
             data.legalTip is number && data.legalTip >= 0 &&
             data.modifiedNcf is string && (data.modifiedNcf == '' || data.modifiedNcf.matches('^(B[0-9]{10}|E[0-9]{12})$')) &&
             data.incomeWithholdingType is string &&
             (data.incomeWithholdingType == '' || data.incomeWithholdingType.matches('^0[1-9]$')) &&
             data.total is number && data.total > 0 &&
             data.total >= data.subtotal + data.itbis + data.selectiveTax + data.otherTaxes + data.legalTip - 0.01 &&
             data.total <= data.subtotal + data.itbis + data.selectiveTax + data.otherTaxes + data.legalTip + 0.01 &&
             data.paymentMethod in ['01', '02', '03', '04', '05', '06', '07'] &&
             data.concept is string && data.concept.size() > 0 && data.concept.size() <= 300 &&
             data.status in ['pending', 'paid'] &&
             data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid &&
             data.createdAt == request.time && data.updatedAt == request.time &&
             (data.paidAt == null || data.paidAt == request.time) &&
             ((data.itbisWithheld == 0 && data.incomeTaxWithheld == 0) || data.paymentDate.size() == 10) &&
             (data.status == 'pending' || data.paymentDate.size() == 10);
    }

    function isValidPurchasePaymentUpdate() {
      return resource.data.status == 'pending' && request.resource.data.status == 'paid' &&
             request.resource.data.paymentDate is string && request.resource.data.paymentDate.size() == 10 &&
             request.resource.data.paidAt == request.time && request.resource.data.updatedAt == request.time &&
             request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentDate', 'paidAt', 'updatedAt', 'updatedBy']);
    }

    function isValidPurchaseRegistryCreate(companyCode) {
      let data = request.resource.data;
      return data.keys().hasAll(['supplierRnc', 'ncf', 'purchaseId', 'companyCode', 'createdBy', 'timestamp']) &&
             data.keys().hasOnly(['supplierRnc', 'ncf', 'purchaseId', 'companyCode', 'createdBy', 'timestamp']) &&
             data.supplierRnc is string && data.supplierRnc.matches('^([0-9]{9}|[0-9]{11})$') &&
             data.ncf is string && (data.ncf.matches('^B[0-9]{10}$') || data.ncf.matches('^E[0-9]{12}$')) &&
             data.purchaseId is string && data.purchaseId.size() > 0 &&
             data.companyCode == companyCode &&
             data.createdBy == request.auth.uid &&
             data.timestamp == request.time;
    }

    function isValidBankMovementCreate() {
      let data = request.resource.data;
      return data.date is string && data.date.size() == 10 &&
             data.account is string && data.account.size() > 0 && data.account.size() <= 100 &&
             data.type in ['deposit', 'transfer_in', 'withdrawal', 'transfer_out', 'check'] &&
             data.reference is string && data.reference.size() > 0 && data.reference.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 300 &&
             data.status == 'pending' && data.createdBy == request.auth.uid &&
             data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidBankReconciliation() {
      return resource.data.status == 'pending' && request.resource.data.status == 'reconciled' &&
             request.resource.data.reconciledAt == request.time && request.resource.data.reconciledBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reconciledAt', 'reconciledBy', 'updatedAt']);
    }

    function isValidBillingClient() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.rnc is string && data.rnc.size() <= 30 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.email is string && data.email.size() <= 150 &&
             data.address is string && data.address.size() <= 300;
    }

    function isValidRestaurantOrder(tableId) {
      let data = request.resource.data;
      return data.keys().hasAll([
               'table', 'clientName', 'items', 'notes', 'priority', 'status', 'waiterName',
               'createdBy', 'updatedBy', 'revision', 'cycle', 'createdAt', 'statusChangedAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'table', 'clientName', 'items', 'notes', 'priority', 'status', 'waiterName',
               'createdBy', 'updatedBy', 'revision', 'cycle', 'createdAt', 'statusChangedAt', 'updatedAt',
               'linkedInvoiceId', 'closedAt', 'closedBy', 'cancellationReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             data.table == tableId && data.table is string && data.table.size() > 0 && data.table.size() <= 50 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 150 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.priority in ['normal', 'high', 'urgent'] &&
             data.status in ['pending', 'preparing', 'ready', 'served', 'pending_payment', 'closed', 'cancelled'] &&
             data.waiterName is string && data.waiterName.size() > 0 && data.waiterName.size() <= 150 &&
             data.createdBy is string && data.createdBy.size() > 0 &&
             data.updatedBy == request.auth.uid &&
             data.revision is int && data.revision > 0 &&
             data.cycle is int && data.cycle > 0 &&
             data.createdAt is timestamp && data.statusChangedAt is timestamp && data.updatedAt == request.time &&
             (data.status != 'closed' || (
               data.linkedInvoiceId is string && data.linkedInvoiceId.size() > 0 &&
               data.closedAt == request.time && data.closedBy == request.auth.uid &&
               existsAfter(/databases/$(database)/documents/panitas_invoices/$(data.linkedInvoiceId))
             )) &&
             (data.status != 'cancelled' || (
               data.cancellationReason is string && data.cancellationReason.size() > 2 && data.cancellationReason.size() <= 500 &&
               data.cancelledAt == request.time && data.cancelledBy == request.auth.uid
             ));
    }

    function isValidRestaurantTransition() {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return before == after ||
             (before == 'pending' && after in ['preparing', 'closed', 'cancelled']) ||
             (before == 'preparing' && after in ['pending', 'ready', 'closed', 'cancelled']) ||
             (before == 'ready' && after in ['pending', 'served', 'closed', 'cancelled']) ||
             (before == 'served' && after in ['pending_payment', 'closed', 'cancelled']) ||
             (before == 'pending_payment' && after in ['closed', 'cancelled']) ||
             (before == 'delivered' && after in ['closed', 'cancelled']) ||
             (before in ['closed', 'cancelled'] && after == 'pending');
    }

    function isValidRestaurantOrderVersion() {
      let data = request.resource.data;
      let isLegacy = !('revision' in resource.data) || !('cycle' in resource.data) || !('createdAt' in resource.data);
      let startsNewCycle = resource.data.status in ['closed', 'cancelled'] && data.status == 'pending';
      return (isLegacy && data.revision == 1 && data.cycle == 1) ||
             (!isLegacy && data.revision == resource.data.revision + 1 && (
               (startsNewCycle && data.cycle == resource.data.cycle + 1 && data.createdAt == request.time && data.createdBy == request.auth.uid) ||
               (!startsNewCycle && data.cycle == resource.data.cycle && data.createdAt == resource.data.createdAt && data.createdBy == resource.data.createdBy)
             ));
    }

    function protectsPreparedRestaurantItems() {
      return request.resource.data.items == resource.data.items ||
             resource.data.status == 'pending' ||
             request.resource.data.status in ['pending', 'closed', 'cancelled'];
    }

    function isValidRestaurantOrderEvent() {
      let data = request.resource.data;
      return data.keys().hasAll(['orderId', 'table', 'fromStatus', 'toStatus', 'action', 'revision', 'cycle', 'userId', 'userEmail', 'timestamp']) &&
             data.keys().hasOnly(['orderId', 'table', 'fromStatus', 'toStatus', 'action', 'revision', 'cycle', 'userId', 'userEmail', 'timestamp']) &&
             data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 50 &&
             data.table == data.orderId &&
             data.fromStatus is string && data.fromStatus.size() <= 30 &&
             data.toStatus in ['pending', 'preparing', 'ready', 'served', 'pending_payment', 'closed', 'cancelled'] &&
             data.action in ['created', 'items_updated', 'details_updated', 'status_changed', 'cancelled', 'invoiced_and_closed'] &&
             data.revision is int && data.revision > 0 && data.cycle is int && data.cycle > 0 &&
             data.userId == request.auth.uid && data.userEmail is string && data.userEmail.size() <= 150 &&
             data.timestamp == request.time &&
             existsAfter(/databases/$(database)/documents/panitas_table_orders/$(data.orderId)) &&
             getAfter(/databases/$(database)/documents/panitas_table_orders/$(data.orderId)).data.table == data.table &&
             getAfter(/databases/$(database)/documents/panitas_table_orders/$(data.orderId)).data.status == data.toStatus &&
             getAfter(/databases/$(database)/documents/panitas_table_orders/$(data.orderId)).data.revision == data.revision &&
             getAfter(/databases/$(database)/documents/panitas_table_orders/$(data.orderId)).data.cycle == data.cycle;
    }

    // ─── USERS Collection ───
    match /users/{userId} {
      // Logged-in users can read their own data, admins/editors can read all (if email verified)
      allow read: if isEmailVerified() && (
        isOwner(userId) || isEditorOrAbove() || isPlatformSupport() || isPlatformBilling()
      );

      // Allow list access only to admins and above (mitigates global users disclosure)
      allow list: if isAdminOrAbove() || isPlatformSupport() || isPlatformBilling();

      // El registro público solo puede crear usuarios sin privilegios.
      // El primer administrador debe aprovisionarse mediante Firebase Admin o consola segura.
      allow create: if (isSignedIn() && isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(['user'])) || isSuperAdmin();

      // Users can update their own profile (only basic non-sensitive fields and if email verified)
      allow update: if isEmailVerified() && isOwner(userId) && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roles', 'status', 'companyCode', 'isInternetClient', 'clientCode', 'internetPlan',
          'internetStatus', 'latitude', 'longitude', 'locationNotes', 'locationAccuracy'
        ])) ||
        (resource.data.status == 'pending_verification' &&
         request.resource.data.status == 'active' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'roles', 'companyCode', 'isInternetClient', 'clientCode', 'internetPlan',
           'internetStatus', 'latitude', 'longitude', 'locationNotes', 'locationAccuracy'
         ]))
      );

      // Admins can update users, but only a superadmin may grant, remove
      // or modify the superadmin role.
      allow update: if isAdminOrAbove() && (
        isSuperAdmin() || (
          !documentHasRole(resource.data, 'superadmin') &&
          !documentHasRole(request.resource.data, 'superadmin')
        )
      );
      allow update: if (isPlatformSupport() || isPlatformBilling()) &&
                       isScopedInternetClientUpdate();

      // Only superadmin can delete users
      allow delete: if isSuperAdmin();
    }

    // ─── PRODUCTS Collection ───
    match /products/{productId} {
      // Anyone can read products (public catalog)
      allow read: if true;

      // Only editors and above can create/update products
      allow create: if isEditorOrAbove() || isFutunetAdmin() || isCreaticosAdmin();
      allow update: if isEditorOrAbove() || isFutunetAdmin() || isCreaticosAdmin() || (
        (isFutunetOperator() || isCreaticosOperator()) &&
        (
          (isFutunetOperator() && hasFutunetInventoryMovement(productId, 'products')) ||
          (isCreaticosOperator() && hasCreaticosInventoryMovement(productId, 'products'))
        )
      );

      // Only admins can delete products
      allow delete: if false;
    }

    // ─── CARTS Collection ───
    match /carts/{cartId} {
      // Users can read their own carts, admins/editors can read all (if email verified)
      allow read: if isEmailVerified() && (
        cartId == request.auth.uid || isEditorOrAbove()
      );

      // Users can create/update/delete their own carts (if email verified)
      allow create, update, delete: if isEmailVerified() && cartId == request.auth.uid;
    }

    // ─── ORDERS Collection ───
    match /orders/{orderId} {
      // Users can read their own orders, admins/editors can read all (if email verified)
      allow read: if isEmailVerified() && (
        resource.data.userId == request.auth.uid || isEditorOrAbove() ||
        isPlatformSupport() || isPlatformBilling()
      );

      // Client-side document creation is blocked (orders are created securely via backend API)
      allow create: if false;

      // Only admins/editors can update order status
      allow update: if isEditorOrAbove() || isPlatformSupport() || isPlatformBilling();

      // Only superadmin can delete orders
      allow delete: if isSuperAdmin();
    }

    // ─── DISCOUNTS Collection ───
    match /discounts/{code} {
      // Anyone signed in with email verified can read discounts (to validate codes)
      allow read: if isEmailVerified();

      // Only admins can manage discounts
      allow create, update, delete: if isAdminOrAbove() || isPlatformMarketing();
    }

    // ─── CONFIG Collection ───
    match /config/{docId} {
      // Anyone can read config (site settings are public)
      allow read: if true;

      // Only admin or above can change config
      allow write: if isAdminOrAbove();
    }

    // ─── BANNERS Collection ───
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isEditorOrAbove() || isPlatformMarketing();
    }

    // ─── CATEGORIES Collection ───
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isEditorOrAbove();
    }

    // ─── BRANDS Collection ───
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isEditorOrAbove();
    }

    // ─── SEARCH QUERIES Collection ───
    match /search_queries/{queryId} {
      // Validate queries limits to protect database from bloat/DoS
      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasOnly(['query', 'timestamp']) &&
                    request.resource.data.query is string &&
                    request.resource.data.query.size() <= 100 &&
                    request.resource.data.timestamp == request.time;
      allow read: if isAdminOrAbove() || isPlatformMarketing();
      allow delete: if isAdminOrAbove();
    }

    // ─── SERVICES CONFIG Collection ───
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isEditorOrAbove();
    }

    // ─── COMPETITORS Collection ───
    match /competitors/{competitorId} {
      allow read, write: if isEditorOrAbove() || isPlatformMarketing();
    }

    // ─── CREATICOS BILLING Collections ───
    match /creaticos_invoices/{invoiceId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && isValidBillingInvoice() && hasValidNewBillingNcf() && hasValidBillingCreateAudit() &&
                       request.resource.data.companyCode == 'CREATICOS' &&
                       (request.resource.data.ncf == '' || (
                         existsAfter(/databases/$(database)/documents/creaticos_ncf_registry/$(request.resource.data.ncf)) &&
                         getAfter(/databases/$(database)/documents/creaticos_ncf_registry/$(request.resource.data.ncf)).data.invoiceId == invoiceId
                       ));
      allow update: if isValidBillingInvoice() && preservesBillingIdentity() && hasValidBillingUpdateAudit() && (
        (isCreaticosAdmin() && isCancellationOnlyInvoiceUpdate()) ||
        (isCreaticosAdmin() && isFiscalAdjustmentOnlyInvoiceUpdate() &&
          existsAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.lastAdjustmentId)) &&
          matchesFiscalAdjustment(
            getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.lastAdjustmentId)).data,
            invoiceId
          )) ||
        (isCreaticosOperator() && resource.data.docType in ['quote', 'proforma']) ||
        (isCreaticosOperator() && isPaymentOnlyInvoiceUpdate() &&
          existsAfter(/databases/$(database)/documents/creaticos_payments/$(request.resource.data.lastPaymentId)) &&
          getAfter(/databases/$(database)/documents/creaticos_payments/$(request.resource.data.lastPaymentId)).data.invoiceId == invoiceId &&
          getAfter(/databases/$(database)/documents/creaticos_payments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.paidAmount - resource.data.paidAmount)
      );
      allow delete: if false;
    }
    match /creaticos_clients/{clientId} {
      allow read: if isCreaticosOperator();
      allow create, update: if isCreaticosOperator() && isValidBillingClient();
      allow delete: if isCreaticosAdmin();
    }
    match /creaticos_payments/{paymentId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && isValidBillingPayment() && request.resource.data.companyCode == 'CREATICOS' &&
                       existsAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)) &&
                       getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)).data.lastPaymentId == paymentId &&
                       getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)).data.paidAmount ==
                         request.resource.data.amount +
                         (exists(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId))
                           ? get(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)).data.paidAmount
                           : 0);
      allow update, delete: if false;
    }
    match /creaticos_inventory_movements/{movementId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && isValidInventoryMovement() &&
                       existsAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)) &&
                       inventoryMovementMatchesInvoice(
                         getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)).data
                       );
      allow update, delete: if false;
    }
    match /creaticos_ncf_registry/{ncf} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && ncf == request.resource.data.ncf &&
                       isValidNcfRegistryCreate('CREATICOS') &&
                       existsAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)) &&
                       getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.invoiceId)).data.ncf == ncf;
      allow update, delete: if false;
    }
    match /creaticos_refunds/{refundId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosAdmin() && isValidRefundCreate('CREATICOS') &&
                       existsAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.adjustmentId)) &&
                       getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.adjustmentId)).data.originalInvoiceId == request.resource.data.invoiceId &&
                       getAfter(/databases/$(database)/documents/creaticos_invoices/$(request.resource.data.adjustmentId)).data.refundAmount == request.resource.data.amount;
      allow update, delete: if false;
    }
    match /creaticos_purchases/{purchaseId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && request.resource.data.companyCode == 'CREATICOS' && isValidPurchaseCreate() &&
                       existsAfter(/databases/$(database)/documents/creaticos_purchase_ncf_registry/$(request.resource.data.supplierRnc + '_' + request.resource.data.ncf)) &&
                       getAfter(/databases/$(database)/documents/creaticos_purchase_ncf_registry/$(request.resource.data.supplierRnc + '_' + request.resource.data.ncf)).data.purchaseId == purchaseId;
      allow update: if isCreaticosOperator() && isValidPurchasePaymentUpdate();
      allow delete: if false;
    }
    match /creaticos_purchase_ncf_registry/{registryId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() &&
                       registryId == request.resource.data.supplierRnc + '_' + request.resource.data.ncf &&
                       isValidPurchaseRegistryCreate('CREATICOS') &&
                       existsAfter(/databases/$(database)/documents/creaticos_purchases/$(request.resource.data.purchaseId)) &&
                       getAfter(/databases/$(database)/documents/creaticos_purchases/$(request.resource.data.purchaseId)).data.ncf == request.resource.data.ncf;
      allow update, delete: if false;
    }
    match /creaticos_bank_movements/{movementId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && request.resource.data.companyCode == 'CREATICOS' && isValidBankMovementCreate();
      allow update: if isCreaticosOperator() && isValidBankReconciliation();
      allow delete: if false;
    }
    match /creaticos_products/{productId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosAdmin();
      allow delete: if false;
      allow update: if isCreaticosAdmin() || (
        isCreaticosOperator() &&
        hasCreaticosInventoryMovement(productId, 'creaticos_products')
      );
    }
    match /creaticos_settings/{settingId} {
      allow read: if isCreaticosOperator();
      allow create, delete: if isCreaticosAdmin();
      allow update: if isCreaticosAdmin() || (
        isCreaticosOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nextInvoiceNum', 'nextQuoteNum', 'nextProformaNum',
          'ncfB01Seq', 'ncfB02Seq', 'ncfB03Seq', 'ncfB04Seq',
          'ncfB12Seq', 'ncfB14Seq', 'ncfB15Seq'
        ])
      );
    }
    match /creaticos_secrets/{secretId} {
      allow read: if false;
      allow write: if isCreaticosAdmin();
    }
    match /creaticos_cash_sessions/{sessionId} {
      allow read: if isCreaticosOperator();
      allow create: if isCreaticosOperator() && isValidCashSessionCreate();
      allow update: if isCreaticosOperator() && isCashSessionOwner() && isValidCashSessionUpdate();
      allow delete: if false;
    }

    // ─── FUTUNET BILLING Collections ───
    match /futunet_invoices/{invoiceId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && isValidBillingInvoice() && hasValidNewBillingNcf() && hasValidBillingCreateAudit() &&
                       request.resource.data.companyCode == 'FUTUNETSRL' &&
                       (request.resource.data.ncf == '' || (
                         existsAfter(/databases/$(database)/documents/futunet_ncf_registry/$(request.resource.data.ncf)) &&
                         getAfter(/databases/$(database)/documents/futunet_ncf_registry/$(request.resource.data.ncf)).data.invoiceId == invoiceId
                       ));
      allow update: if isValidBillingInvoice() && preservesBillingIdentity() && hasValidBillingUpdateAudit() && (
        (isFutunetAdmin() && isCancellationOnlyInvoiceUpdate()) ||
        (isFutunetAdmin() && isFiscalAdjustmentOnlyInvoiceUpdate() &&
          existsAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.lastAdjustmentId)) &&
          matchesFiscalAdjustment(
            getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.lastAdjustmentId)).data,
            invoiceId
          )) ||
        (isFutunetOperator() && resource.data.docType in ['quote', 'proforma']) ||
        (isFutunetOperator() && isPaymentOnlyInvoiceUpdate() &&
          existsAfter(/databases/$(database)/documents/futunet_payments/$(request.resource.data.lastPaymentId)) &&
          getAfter(/databases/$(database)/documents/futunet_payments/$(request.resource.data.lastPaymentId)).data.invoiceId == invoiceId &&
          getAfter(/databases/$(database)/documents/futunet_payments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.paidAmount - resource.data.paidAmount)
      );
      allow delete: if false;
    }
    match /futunet_clients/{clientId} {
      allow read: if isFutunetOperator();
      allow create, update: if isFutunetOperator() && isValidBillingClient();
      allow delete: if isFutunetAdmin();
    }
    match /futunet_payments/{paymentId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && isValidBillingPayment() && request.resource.data.companyCode == 'FUTUNETSRL' &&
                       existsAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)) &&
                       getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)).data.lastPaymentId == paymentId &&
                       getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)).data.paidAmount ==
                         request.resource.data.amount +
                         (exists(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId))
                           ? get(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)).data.paidAmount
                           : 0);
      allow update, delete: if false;
    }
    match /futunet_inventory_movements/{movementId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && isValidInventoryMovement() &&
                       existsAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)) &&
                       inventoryMovementMatchesInvoice(
                         getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)).data
                       );
      allow update, delete: if false;
    }
    match /futunet_ncf_registry/{ncf} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && ncf == request.resource.data.ncf &&
                       isValidNcfRegistryCreate('FUTUNETSRL') &&
                       existsAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)) &&
                       getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.invoiceId)).data.ncf == ncf;
      allow update, delete: if false;
    }
    match /futunet_refunds/{refundId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetAdmin() && isValidRefundCreate('FUTUNETSRL') &&
                       existsAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.adjustmentId)) &&
                       getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.adjustmentId)).data.originalInvoiceId == request.resource.data.invoiceId &&
                       getAfter(/databases/$(database)/documents/futunet_invoices/$(request.resource.data.adjustmentId)).data.refundAmount == request.resource.data.amount;
      allow update, delete: if false;
    }
    match /futunet_purchases/{purchaseId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && request.resource.data.companyCode == 'FUTUNETSRL' && isValidPurchaseCreate() &&
                       existsAfter(/databases/$(database)/documents/futunet_purchase_ncf_registry/$(request.resource.data.supplierRnc + '_' + request.resource.data.ncf)) &&
                       getAfter(/databases/$(database)/documents/futunet_purchase_ncf_registry/$(request.resource.data.supplierRnc + '_' + request.resource.data.ncf)).data.purchaseId == purchaseId;
      allow update: if isFutunetOperator() && isValidPurchasePaymentUpdate();
      allow delete: if false;
    }
    match /futunet_purchase_ncf_registry/{registryId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() &&
                       registryId == request.resource.data.supplierRnc + '_' + request.resource.data.ncf &&
                       isValidPurchaseRegistryCreate('FUTUNETSRL') &&
                       existsAfter(/databases/$(database)/documents/futunet_purchases/$(request.resource.data.purchaseId)) &&
                       getAfter(/databases/$(database)/documents/futunet_purchases/$(request.resource.data.purchaseId)).data.ncf == request.resource.data.ncf;
      allow update, delete: if false;
    }
    match /futunet_bank_movements/{movementId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && request.resource.data.companyCode == 'FUTUNETSRL' && isValidBankMovementCreate();
      allow update: if isFutunetOperator() && isValidBankReconciliation();
      allow delete: if false;
    }
    match /futunet_settings/{settingId} {
      allow read: if isFutunetOperator();
      allow create, delete: if isFutunetAdmin();
      allow update: if isFutunetAdmin() || (
        isFutunetOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nextInvoiceNum', 'nextQuoteNum', 'nextProformaNum',
          'ncfB01Seq', 'ncfB02Seq', 'ncfB03Seq', 'ncfB04Seq',
          'ncfB12Seq', 'ncfB14Seq', 'ncfB15Seq'
        ])
      );
    }
    match /futunet_secrets/{secretId} {
      allow read: if false;
      allow write: if isFutunetAdmin();
    }
    match /futunet_cash_sessions/{sessionId} {
      allow read: if isFutunetOperator();
      allow create: if isFutunetOperator() && isValidCashSessionCreate();
      allow update: if isFutunetOperator() && isCashSessionOwner() && isValidCashSessionUpdate();
      allow delete: if false;
    }

    // ─── PANITAS BILLING Collections ───
    match /panitas_invoices/{invoiceId} {
      allow read: if isPanitasOperator();
      allow create: if isPanitasOperator() && isValidBillingInvoice() && hasValidNewBillingNcf() && hasValidBillingCreateAudit() && request.resource.data.companyCode == 'PANITAS';
      allow update: if isValidBillingInvoice() && preservesBillingIdentity() && hasValidBillingUpdateAudit() && (
        (isPanitasAdmin() && isCancellationOnlyInvoiceUpdate()) ||
        (isPanitasOperator() && resource.data.docType in ['quote', 'proforma']) ||
        (isPanitasOperator() && isPaymentOnlyInvoiceUpdate() &&
          existsAfter(/databases/$(database)/documents/panitas_payments/$(request.resource.data.lastPaymentId)) &&
          getAfter(/databases/$(database)/documents/panitas_payments/$(request.resource.data.lastPaymentId)).data.invoiceId == invoiceId &&
          getAfter(/databases/$(database)/documents/panitas_payments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.paidAmount - resource.data.paidAmount)
      );
      allow delete: if false;
    }
    match /panitas_clients/{clientId} {
      allow read: if isPanitasOperator();
      allow create, update: if isPanitasOperator() && isValidBillingClient();
      allow delete: if isPanitasAdmin();
    }
    match /panitas_payments/{paymentId} {
      allow read: if isPanitasOperator();
      allow create: if isPanitasOperator() && isValidBillingPayment() && request.resource.data.companyCode == 'PANITAS' &&
                       existsAfter(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)) &&
                       getAfter(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)).data.lastPaymentId == paymentId &&
                       getAfter(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)).data.paidAmount ==
                         request.resource.data.amount +
                         (exists(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId))
                           ? get(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)).data.paidAmount
                           : 0);
      allow update, delete: if false;
    }
    match /panitas_inventory_movements/{movementId} {
      allow read: if isPanitasOperator();
      allow create: if isPanitasOperator() && isValidInventoryMovement() &&
                       existsAfter(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)) &&
                       inventoryMovementMatchesInvoice(
                         getAfter(/databases/$(database)/documents/panitas_invoices/$(request.resource.data.invoiceId)).data
                       );
      allow update, delete: if false;
    }
    match /panitas_products/{productId} {
      allow read: if isPanitasOperator();
      allow create: if isPanitasAdmin();
      allow delete: if false;
      allow update: if isPanitasAdmin() || (
        isPanitasOperator() &&
        hasPanitasInventoryMovement(productId, 'panitas_products')
      );
    }
    match /panitas_settings/{settingId} {
      allow read: if isPanitasOperator() || isPanitasKitchen();
      allow create, delete: if isPanitasAdmin();
      allow update: if isPanitasAdmin() || (
        isPanitasOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nextInvoiceNum', 'nextQuoteNum', 'nextProformaNum',
          'ncfB01Seq', 'ncfB02Seq', 'ncfB12Seq', 'ncfB14Seq', 'ncfB15Seq'
        ])
      );
    }
    match /panitas_secrets/{secretId} {
      allow read: if false;
      allow write: if isPanitasAdmin();
    }
    match /panitas_cash_sessions/{sessionId} {
      allow read: if isPanitasOperator();
      allow create: if isPanitasOperator() && isValidCashSessionCreate();
      allow update: if isPanitasOperator() && isCashSessionOwner() && isValidCashSessionUpdate();
      allow delete: if false;
    }
    match /panitas_table_orders/{tableId} {
      allow read: if isPanitasOperator() || isPanitasKitchen();
      allow create: if isPanitasOperator() &&
                       isValidRestaurantOrder(tableId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.revision == 1 &&
                       request.resource.data.cycle == 1 &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.statusChangedAt == request.time;
      allow update: if (isPanitasOperator() || (
                         isPanitasKitchen() && (
                           !('revision' in resource.data) ||
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'revision', 'cycle', 'updatedBy', 'statusChangedAt', 'updatedAt'
                           ])
                         )
                       )) &&
                       isValidRestaurantOrder(tableId) &&
                       isValidRestaurantTransition() &&
                       isValidRestaurantOrderVersion() &&
                       protectsPreparedRestaurantItems() &&
                       (!('statusChangedAt' in resource.data) || (
                         request.resource.data.status == resource.data.status
                           ? request.resource.data.statusChangedAt == resource.data.statusChangedAt
                           : request.resource.data.statusChangedAt == request.time
                       ));
      allow delete: if isPanitasAdmin();
    }
    match /panitas_order_events/{eventId} {
      allow read: if isPanitasOperator() || isPanitasKitchen();
      allow create: if (isPanitasOperator() || isPanitasKitchen()) && isValidRestaurantOrderEvent();
      allow update: if false;
      allow delete: if isPanitasAdmin();
    }

    // ─── IMMUTABLE AUDIT LOG ───
    match /audit_logs/{logId} {
      allow create: if isEmailVerified() &&
                    request.resource.data.keys().hasAll(['action', 'details', 'userEmail', 'userId', 'timestamp']) &&
                    request.resource.data.keys().hasOnly(['action', 'details', 'userEmail', 'userId', 'timestamp', 'metadata']) &&
                    request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 150 &&
                    request.resource.data.details is string && request.resource.data.details.size() <= 1500 &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userEmail == request.auth.token.email &&
                    request.resource.data.timestamp == request.time;
      allow read: if isEditorOrAbove() || isAnyTenantAdmin();
      allow update, delete: if false;
    }

    // ─── SERVICE REQUESTS Collection ───
    match /service_requests/{requestId} {
      // Whitelist fields, enforce status 'pending', validate types and limit lengths
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'message', 'serviceId', 'serviceTitle', 'status', 'type', 'createdAt']) &&
                    request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'message', 'serviceId', 'serviceTitle', 'status', 'type', 'createdAt', 'company', 'planRequested', 'profile']) &&
                    request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
                    request.resource.data.phone is string && request.resource.data.phone.size() <= 50 &&
                    request.resource.data.email is string && request.resource.data.email.size() <= 100 &&
                    request.resource.data.message is string && request.resource.data.message.size() <= 1500 &&
                    request.resource.data.serviceId is string && request.resource.data.serviceId.size() <= 50 &&
                    request.resource.data.serviceTitle is string && request.resource.data.serviceTitle.size() <= 100 &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.type in ['standard_service', 'internet_hiring'] &&
                    request.resource.data.createdAt == request.time &&
                    (!('company' in request.resource.data.keys()) || (request.resource.data.company is string && request.resource.data.company.size() <= 100)) &&
                    (!('planRequested' in request.resource.data.keys()) || (request.resource.data.planRequested is string && request.resource.data.planRequested.size() <= 100)) &&
                    (!('profile' in request.resource.data.keys()) || (request.resource.data.profile is string && request.resource.data.profile.size() <= 50));
      allow read: if isEditorOrAbove() || isPlatformSupport();
      allow update: if (isEditorOrAbove() || isPlatformSupport()) &&
                       isValidServiceRequestCompletion();
      allow delete: if isSuperAdmin();
    }

    // ─── INTERNET PAYMENTS Collection ───
    match /internet_payments/{paymentId} {
      // Validate payment submission fields and enforce status pending (if email verified)
      allow create: if isEmailVerified() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.amount is number &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.timestamp == request.time &&
                    request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'amount', 'bank', 'voucherUrl', 'storagePath', 'status', 'plan', 'timestamp']) &&
                    request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
                    request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 100 &&
                    request.resource.data.bank is string && request.resource.data.bank.size() <= 50 &&
                    request.resource.data.voucherUrl is string && request.resource.data.voucherUrl.size() <= 500 &&
                    request.resource.data.storagePath is string && request.resource.data.storagePath.size() <= 500 &&
                    request.resource.data.plan is string && request.resource.data.plan.size() <= 50;
      allow read: if isEmailVerified() && (
        resource.data.userId == request.auth.uid || isEditorOrAbove() ||
        isPlatformSupport() || isPlatformBilling()
      );
      allow update: if (isEditorOrAbove() || isPlatformSupport() || isPlatformBilling()) &&
                       isValidInternetPaymentReview();
      allow delete: if isSuperAdmin();
    }

    // ─── INTERNET TICKETS Collection ───
    match /internet_tickets/{ticketId} {
      // Validate technical support ticket fields and enforce status pending (if email verified)
      allow create: if isEmailVerified() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.timestamp == request.time &&
                    request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'type', 'details', 'status', 'timestamp', 'requestedPlan']) &&
                    request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
                    request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 100 &&
                    request.resource.data.type is string && request.resource.data.type.size() <= 50 &&
                    request.resource.data.details is string && request.resource.data.details.size() <= 1500 &&
                    (!('requestedPlan' in request.resource.data.keys()) || (request.resource.data.requestedPlan is string && request.resource.data.requestedPlan.size() <= 50));
      allow read: if isEmailVerified() && (
        resource.data.userId == request.auth.uid || isEditorOrAbove() ||
        isPlatformSupport() || isPlatformBilling()
      );
      allow update: if isEditorOrAbove() || isPlatformSupport() || isPlatformBilling();
      allow delete: if isSuperAdmin();
    }

    // ─── DENY EVERYTHING ELSE ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
